import json, os

def q(text, options, answer, explanation=""):
    return {
        "question": text,
        "options": options,
        "answer": answer,
        "explanation": explanation
    }

def lesson(i, name, questions):
    return {"id": f"lesson_{i}", "name": name, "questions": questions}

def subject(sid, name, topics):
    return {"id": sid, "name": name, "lessons": [
        lesson(i+1, topic[0], topic[1]) for i, topic in enumerate(topics)
    ]}

def grade(gid, name, subjects):
    return {"id": gid, "name": name, "subjects": subjects}

